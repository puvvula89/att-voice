# Copy to .env and fill in. One .env drives the whole self-contained A2A bundle:
# MCP + voice engine + chat engine (native A2A) + relay + UI + CXAS steering app.
# CES calls the chat engine's A2A endpoint directly (no adapter). Recommended:
# Vertex AI + ADC (`gcloud auth application-default login` first).
#
# Every deployed resource name carries an -a2a suffix so this stack runs SIDE BY
# SIDE with the OpenAPI-tool bundle. Edit only this file to deploy to your project.

# ---- Runtime (agent / relay / MCP) ----
GOOGLE_GENAI_USE_VERTEXAI=TRUE
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_LOCATION=us-central1
LIVE_MODEL=gemini-live-2.5-flash-native-audio
LIVE_VOICE=Charon
CHAT_MODEL=gemini-2.5-flash

# Set by deploy_all.sh after the engines are created (leave blank). A blank
# SESSION_ENGINE_ID makes the deploy create its own voice engine and use it as the
# shared session store shared by every channel.
MCP_SERVER_URL=http://localhost:9000/mcp
AGENT_ENGINE_NAME=
CHAT_AGENT_ENGINE_NAME=
SESSION_ENGINE_ID=

# ---- Deploy: Cloud Run service + Agent Engine display names + staging bucket ----
MCP_SERVICE=att-mcp-phone-upgrade-a2a
RELAY_SERVICE=att-phone-upgrade-relay-a2a
UI_SERVICE=att-phone-upgrade-ui-a2a
AGENT_DISPLAY_NAME=att-phone-upgrade-live-a2a
CHAT_DISPLAY_NAME=att-phone-upgrade-chat-a2a
AE_STAGING_BUCKET=
RELAY_MIN_INSTANCES=1

# ---- CES -> Agent Engine A2A auth ----
# CES per-project service agent (P4SA). CES uses it by default for internal GCP auth
# to the Agent Engine A2A endpoint; deploy_all.sh grants it roles/aiplatform.user.
# Leave blank to derive from the project number (service-<NUM>@gcp-sa-ces...).
CES_SERVICE_AGENT=

# ---- CXAS steering app ----
CXAS_PROJECT=your-project-id
CXAS_LOCATION=us
CXAS_APP_ID=att-ivr-steering-a2a
CXAS_MODEL=gemini-2.5-flash-001
CXAS_CUSTOMER_ID_DEFAULT=demo-customer
# true = attach the A2A sales tool to the Sales Master (requires the RemoteAgentTool
# to exist). false = build the hierarchy without it (Sales Master has no ADK
# delegation) — use while RemoteAgentTool creation is unavailable.
SALES_TOOL_ENABLED=true
