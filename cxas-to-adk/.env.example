# Copy to .env and fill in. One .env drives the whole self-contained bundle:
# MCP + voice engine + chat engine + relay + UI + CXAS adapter + CXAS steering app.
# Recommended: Vertex AI + ADC (`gcloud auth application-default login` first).

# ---- Runtime (agent / relay / MCP / adapter) ----
GOOGLE_GENAI_USE_VERTEXAI=TRUE
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_LOCATION=us-central1
LIVE_MODEL=gemini-live-2.5-flash-native-audio
LIVE_VOICE=Charon
CHAT_MODEL=gemini-2.5-flash

# Set by deploy_all.sh after the engines are created (leave blank). The relay reads
# these to proxy voice (/ws) and chat (/chat); the adapter reads CHAT_AGENT_ENGINE_NAME.
MCP_SERVER_URL=http://localhost:9000/mcp
AGENT_ENGINE_NAME=
CHAT_AGENT_ENGINE_NAME=
SESSION_ENGINE_ID=

# ---- Deploy: Cloud Run service + Agent Engine display names + staging bucket ----
MCP_SERVICE=att-mcp-phone-upgrade
RELAY_SERVICE=att-phone-upgrade-relay
UI_SERVICE=att-phone-upgrade-ui
AGENT_DISPLAY_NAME=att-phone-upgrade-live
CHAT_DISPLAY_NAME=att-phone-upgrade-chat
AE_STAGING_BUCKET=
RELAY_MIN_INSTANCES=1

# ---- CXAS adapter (Cloud Run, private + OIDC) ----
ADAPTER_SERVICE=att-cxas-adapter
# Keep one warm instance so the first CXAS turn doesn't cold-start past the CES
# tool-call timeout (a cold first turn was ~56s). 0 to save cost (may time out).
ADAPTER_MIN_INSTANCES=1
SENTIMENT_ENABLED=true
SENTIMENT_MODEL=gemini-2.5-flash
SENTIMENT_TIMEOUT=4.0
# CES service agent that mints the OIDC token to call the private adapter. Granted
# run.invoker on the adapter by deploy_all.sh. Default derives from the project number.
CES_SERVICE_AGENT=

# ---- CXAS steering app (Conversational Agents, location 'us') ----
CXAS_PROJECT=your-project-id
CXAS_LOCATION=us
CXAS_MODEL=gemini-2.5-flash-001
CXAS_CUSTOMER_ID_DEFAULT=wilson
