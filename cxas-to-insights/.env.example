# Copy to .env and fill in. Read by every script in this folder via python-dotenv.

# --- Project ---
GOOGLE_CLOUD_PROJECT=your-gcp-project
# CXAS_PROJECT overrides GOOGLE_CLOUD_PROJECT for CES if they differ.
# CXAS_PROJECT=your-gcp-project

# CES app location. Valid values: us, eu, global.
# NOTE: this is NOT a GCP region and NOT the same namespace as INSIGHTS_LOCATION.
CXAS_LOCATION=us

# Insights location. For a CES app in `us`, this is the `us` MULTIREGION — the
# same string, not a region like us-central1. Verified: conversations from a CES
# app in `us` land in Insights `us`, and us-central1 stays empty.
#
# Insights also requires a REGIONAL ENDPOINT matching this value, e.g.
# https://us-contactcenterinsights.googleapis.com. The scripts build that host
# automatically; see README "Verify it worked".
INSIGHTS_LOCATION=us

# --- The demo app ---
APP_ID=insights-demo
AGENT_ID=concierge
# Must be a model available in CXAS_LOCATION. gemini-2.5-flash is NOT available
# in `us`; gemini-3.5-flash is.
APP_MODEL=gemini-3.5-flash
