# Copy to .env and fill in. Read by the bootstrap scripts via python-dotenv.

# --- Shared ---
GOOGLE_CLOUD_PROJECT=your-gcp-project
# CXAS_PROJECT overrides GOOGLE_CLOUD_PROJECT for CXAS if they differ.
# CXAS_PROJECT=your-gcp-project
CXAS_LOCATION=us

# --- Voice app (cxas-voice-and-chat, live model) ---
VOICE_APP_ID=cxas-voice-and-chat
VOICE_LIVE_MODEL=gemini-3.1-flash-live

# A2A hop from the voice app's a2a-to-cxas-chat wrapper to the chat app.
# Leave disabled for the first bootstrap; enable once cxas-chat is deployed and
# you have its native A2A endpoint URL.
CHAT_TOOL_ENABLED=false
# CHAT_A2A_URL=https://<region>-aiplatform.googleapis.com/v1beta1/projects/<p>/locations/<l>/reasoningEngines/<id>/a2a

# --- Chat app (cxas-chat, flash model) ---
CHAT_APP_ID=cxas-chat
CHAT_MODEL=gemini-3.5-flash

# --- Cloud Run (hydration service, relay, UI) ---
# Region for the deployed services. NOTE this is a Cloud Run region
# (e.g. us-central1) and is NOT the same as CXAS_LOCATION above (e.g. us).
GOOGLE_CLOUD_LOCATION=us-central1

# Service names. Defaults shown — override only if they collide with something
# already in the project.
# HYDRATION_SERVICE=cxas-hydration
# RELAY_SERVICE=cxas-web-relay
# UI_SERVICE=cxas-web-ui

# Scaling caps. The hydration service and relay both run min-instances=1 so the
# first turn is never a cold start; these bound the upper end.
# HYDRATION_MAX_INSTANCES=3
# RELAY_MAX_INSTANCES=5
