# Copy to .env and fill in. Nothing here is project-specific until you set it,
# so the same code deploys to ANY GCP project. Recommended: Vertex AI + ADC
# (run `gcloud auth application-default login` first).

# ---- Runtime (used by the agent / relay / MCP at run time) ----
GOOGLE_GENAI_USE_VERTEXAI=TRUE
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_LOCATION=us-central1
LIVE_MODEL=gemini-live-2.5-flash-native-audio
LIVE_VOICE=Charon

# MCP server that serves the data tools. Local dev default below; the deploy
# script overwrites this with the deployed Cloud Run URL.
MCP_SERVER_URL=http://localhost:9000/mcp

# Set by the deploy script after the agent is created; the relay reads it to
# proxy to Agent Engine. Leave blank for local in-process (Topology A) dev.
AGENT_ENGINE_NAME=

# Shared session store: the ONE Agent Engine id that backs sessions for ALL
# channels (voice + the future chat agent), so a conversation resumes across
# them. Leave blank and the voice agent uses its own engine (auto-injected as
# GOOGLE_CLOUD_AGENT_ENGINE_ID) — fine until the chat agent exists. To share,
# set both agents to the SAME id here.
SESSION_ENGINE_ID=

# ---- Deploy config (used by deploy/deploy_all.sh) ----
# Cloud Run service names + the Agent Engine display name + staging bucket.
# Defaults are fine; change them to namespace multiple deployments in one project.
MCP_SERVICE=att-mcp-phone-upgrade
RELAY_SERVICE=att-phone-upgrade-relay
UI_SERVICE=att-phone-upgrade-ui
AGENT_DISPLAY_NAME=att-phone-upgrade-live
# Agent Engine staging bucket (no gs:// prefix). Defaults to <project>-agent-engine.
AE_STAGING_BUCKET=
# Keep one relay instance warm to avoid cold-start 503s (0 to save cost).
RELAY_MIN_INSTANCES=1

# ---- Alternative: Google AI Studio (API key) instead of Vertex/ADC ----
# GOOGLE_GENAI_USE_VERTEXAI=FALSE
# GOOGLE_API_KEY=your-api-key
# LIVE_MODEL=gemini-3.1-flash-live-preview
