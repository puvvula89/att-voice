# Copy to .env and fill in. Recommended: Vertex AI + Application Default Credentials.
# First run: gcloud auth application-default login
GOOGLE_GENAI_USE_VERTEXAI=TRUE
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_LOCATION=us-central1
LIVE_MODEL=gemini-live-2.5-flash-native-audio

# MCP server that serves the data tools (get_lines, get_eligible_phones, ...).
# Local dev: run `python -m mcp_server.server` (defaults to :9000).
# Cloud Run: set this to the deployed streamable-HTTP URL (…/mcp).
MCP_SERVER_URL=http://localhost:9000/mcp

# Alternative: Google AI Studio (API key) instead of Vertex/ADC.
# Note: gemini-3.1-flash-live-preview is the newest Live model but is AI Studio only (not on Vertex yet).
# GOOGLE_GENAI_USE_VERTEXAI=FALSE
# GOOGLE_API_KEY=your-api-key
# LIVE_MODEL=gemini-3.1-flash-live-preview
