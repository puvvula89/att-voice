# Copy to .env and fill in. Read by the bootstrap scripts via python-dotenv.

# --- Shared ---
GOOGLE_CLOUD_PROJECT=your-gcp-project
# CXAS_PROJECT overrides GOOGLE_CLOUD_PROJECT for CXAS if they differ.
# CXAS_PROJECT=your-gcp-project
CXAS_LOCATION=us

# --- Voice app (ivr-and-app-voice, live model) ---
# One app serves both voice and text: the modality is per-turn, not per-app, so a
# live model handles typed turns as well as spoken ones.
VOICE_APP_ID=ivr-and-app-voice
VOICE_LIVE_MODEL=gemini-3.1-flash-live

# --- Cloud Run (hydration service, relay, UI) ---
# Region for the deployed services. NOTE this is a Cloud Run region
# (e.g. us-central1) and is NOT the same as CXAS_LOCATION above (e.g. us).
GOOGLE_CLOUD_LOCATION=us-central1

# Service names. Defaults shown — override only if they collide with something
# already in the project.
# HYDRATION_SERVICE=ivr-and-app-hydration
# RELAY_SERVICE=ivr-and-app-relay
# UI_SERVICE=ivr-and-app-ui

# Scaling caps. The hydration service and relay both run min-instances=1 so the
# first turn is never a cold start; these bound the upper end.
# HYDRATION_MAX_INSTANCES=3
# RELAY_MAX_INSTANCES=5

# How long after a conversation ends it is still offered for continuation.
# Measured from the conversation's end_time (its start_time while still open).
# 0 disables the check entirely. Ten minutes is tight for web -> IVR: finding the
# number and working through a menu can easily exceed it, and every minute over
# the line is a handoff that silently does not happen.
# HYDRATION_MAX_AGE_MINUTES=10
