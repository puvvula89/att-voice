# Copy to .env and fill in. Read by the bootstrap and spike scripts via python-dotenv.

# --- Shared ---
GOOGLE_CLOUD_PROJECT=your-gcp-project
# CXAS_PROJECT overrides GOOGLE_CLOUD_PROJECT for CXAS if they differ.
# CXAS_PROJECT=your-gcp-project
CXAS_LOCATION=us

# Cloud Run region for the billing MCP server. NOTE this is a Cloud Run region
# (e.g. us-central1) and is NOT the same as CXAS_LOCATION above (e.g. us).
GOOGLE_CLOUD_LOCATION=us-central1

# --- The IVR app ---
CARE_APP_ID=cricket-care
# Must be a voice-optimized live model, and must be set at app creation.
CARE_LIVE_MODEL=gemini-3.1-flash-live

# Identity is assumed established before the agent is reached (PRD A1); for the
# POC the account is pinned to this persona.
DEMO_CUSTOMER_ID=cust_2001

# --- Billing MCP server (Cloud Run) ---
# MCP_SERVICE=cricket-billing-mcp
# MCP_MAX_INSTANCES=5

# --- Support MCP server (Cloud Run) ---
SUPPORT_MCP_SERVICE=cricket-support-mcp
# Which seeded account profile (P1..P7, PRD §7) the demo customer starts in.
DEMO_PROFILE=P3

# --- Tutorial content ---
# Agent Search data store the agent searches (knowledge/load_datastore.py creates and loads it).
DATASTORE_ID=cricket-tutorials
# Firestore keeps each caller's latest session id, for resuming a dropped call.
FIRESTORE_DATABASE=(default)
FIRESTORE_LOCATION=nam5
# How long after a dropped call a callback resumes where it left off.
RESUME_WINDOW_MINUTES=30
# Gemini model that labels step safety flags (knowledge/enrich.py).
EXTRACT_MODEL=gemini-2.5-flash

# --- Messaging (optional; a trial account sends to verified numbers only) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
DEMO_SMS_NUMBER=
