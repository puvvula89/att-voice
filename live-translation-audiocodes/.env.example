# Copy to .env and fill in. .env is gitignored and never leaves your machine.
#
# Only the four values under "Required" have to be set. Everything below them has
# a working default, so a fresh project needs nothing else to deploy.

# --- Required -----------------------------------------------------------------

# Google Cloud project that will run the bridge and serve Gemini Live Translate.
# The deploy script creates its own service account inside this project.
GOOGLE_CLOUD_PROJECT=

# Bearer token you set on the Live Hub / VoiceAI Connect bot connection. The bridge
# rejects any WebSocket that does not present it. Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
AUDIOCODES_TOKEN=

# BCP-47 code of the caller's language -- the agent-to-caller target. The caller-to-
# agent direction is always English. Changeable per call from the console.
CALLER_LANGUAGE=hi-IN

# loopback (one phone, hears its own translation) | dialin (two inbound calls)
AGENT_MODE=dialin

# --- Optional -----------------------------------------------------------------

# echo (no model, audio is mirrored back -- useful for proving the phone path) | gemini
TRANSLATOR=gemini

# Live Translate is served from the global location; leave this alone unless told.
GOOGLE_CLOUD_LOCATION=global
LIVE_TRANSLATE_MODEL=gemini-3.5-live-translate-preview

# Played when the call connects so VoiceAI Connect answers: silence | tone | none
ANSWER_PROMPT=silence

# Reproduce English the caller speaks so it still reaches the agent. Off by default:
# it also rebroadcasts English picked up from the room, which delays real translations.
ECHO_TO_AGENT=false

# Cloud Run placement. Any region will do; the model is reached globally.
REGION=us-east4
SERVICE=live-translation-bridge
