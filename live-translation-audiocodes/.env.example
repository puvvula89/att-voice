# Copy to .env and fill in. .env is gitignored.

# Bearer token configured on the Live Hub / VAIC bot connection.
AUDIOCODES_TOKEN=

# echo (M0) | gemini (M1+)
TRANSLATOR=echo

# Vertex AI project for Gemini Live Translate (M1+). Live Translate is served from the global location.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
LIVE_TRANSLATE_MODEL=gemini-3.5-live-translate-preview

# Played when the call connects so VoiceAI Connect answers: silence | tone | none
ANSWER_PROMPT=silence
# Reproduce English the caller speaks so it still reaches the agent. Off by default:
# it also rebroadcasts English picked up from the room, which delays real translations.
ECHO_TO_AGENT=false

# AGENT_MODE: loopback | dialin (agent calls the same number) | dialout (bridge dials AGENT_NUMBER)
AGENT_MODE=loopback
LIVEHUB_API_URL=https://livehub.audiocodes.io
LIVEHUB_CLIENT_ID=
LIVEHUB_CLIENT_SECRET=
# Bot connection name; defaults to the botName of the inbound session.
LIVEHUB_BOT_NAME=
# Caller ID for the outbound call (a number owned in Live Hub).
LIVEHUB_CALLER_ID=
AGENT_NUMBER=
# BCP-47 code of the caller's language (agent-to-caller target).
CALLER_LANGUAGE=
